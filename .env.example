# Port on which the server listens (defaults to 3000 if not set)
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=production

# CREATOR_PASSPHRASE: Optional pre-configured master creator passphrase (must be >= 50 characters).
# If left empty, the application will prompt you with the Creator Setup wizard upon first visit.
CREATOR_PASSPHRASE=

# Optional: Gemini API key for server-side AI integrations (if enabled)
GEMINI_API_KEY=

# Optional: Public Application URL (used for absolute links or proxy deployments)
APP_URL=
